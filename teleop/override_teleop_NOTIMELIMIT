#include "main.h"
#include "lemlib/api.hpp" // IWYU pragma: keep
#include "pros/misc.h"

pros::MotorGroup left_motors({-4, -7, -16});
pros::MotorGroup right_motors({1, 15, 6});

pros::Motor liftL(20, pros::v5::MotorGears::green);
pros::Motor liftR(-12, pros::v5::MotorGears::green);

pros::adi::DigitalOut claw('H');

lemlib::Drivetrain drivetrain(&left_motors, // left motor group
                              &right_motors, // right motor group
                              11.4,
                              lemlib::Omniwheel::NEW_325,
                              450,
                              2 // horizontal drift is 2 (for now)
);


// lateral PID controller
lemlib::ControllerSettings lateral_controller(10, // proportional gain (kP)
                                              0, // integral gain (kI)
                                              15, // derivative gain (kD)
                                              0, // anti windup
                                              1, // small error range, in inches
                                              100, // small error range timeout, in milliseconds
                                              0, // large error range, in inches
                                              0, // large error range timeout, in milliseconds
                                              0 // maximum acceleration (slew)
);

// angular PID controller
lemlib::ControllerSettings angular_controller(1, // proportional gain (kP)
                                              0, // integral gain (kI)
                                              5, // derivative gain (kD)
                                              0, // anti windup
                                              1, // small error range, in degrees
                                              100, // small error range timeout, in milliseconds
                                              0, // large error range, in degrees
                                              0, // large error range timeout, in milliseconds
                                              0 // maximum acceleration (slew)
);

pros::IMU inertial_sensor(19);

pros::Controller master(pros::E_CONTROLLER_MASTER);

//pros::Imu inertial_sensor(19);

// odometry struct
lemlib::OdomSensors sensors(nullptr, // vertical tracking wheel 1
                            nullptr, // vertical tracking wheel 2
                            nullptr, // horizontal tracking wheel 1
                            nullptr, // horizontal tracking wheel 2, set to nullptr as we don't have a second one
                            &inertial_sensor // inertial sensor
);

// create the chassis
lemlib::Chassis chassis(drivetrain, // drivetrain settings
                        lateral_controller, // lateral PID settings
                        angular_controller, // angular PID settings
                        sensors // odometry sensors
);


/**
 * A callback function for LLEMU's center button.
 *
 * When this callback is fired, it will toggle line 2 of the LCD text between
 * "I was pressed!" and nothing.
 */
void on_center_button() {
	static bool pressed = false;
	pressed = !pressed;
	if (pressed) {
		pros::lcd::set_text(2, "I was pressed!");
	} else {
		pros::lcd::clear_line(2);
	}
}

//**TEST!!!!**
void drive(void* param) {
    
    while (true) {
        int leftY = master.get_analog(pros::E_CONTROLLER_ANALOG_LEFT_Y);
        int rightX = master.get_analog(pros::E_CONTROLLER_ANALOG_RIGHT_X);

        // move the robot
        chassis.arcade(leftY, rightX*0.8);

        pros::delay(50);
    }
}


void lift_to(int degrees) {
    liftL.move_absolute(degrees, 100);
    liftR.move_absolute(degrees, 100);
}

void lift_move(int dir) {
    liftL.move(127*dir);
    liftR.move(127*dir);
}

void lift_stop() {
    liftL.brake();
    liftR.brake();
}


bool clamping = false;

// controls the cascade lift
void cascade(void* param) {

    bool macroing = false;
    float targetPos = 0;
    

    while (true) { 
        //int averageMotorDegree = (liftL.position() + liftR.position())/2;


        // go UP
        if (master.get_digital(pros::E_CONTROLLER_DIGITAL_L1)) {
            
            macroing = false;
            liftL.move(127);
            liftR.move(127);

        // go DOWN
        } else if (master.get_digital(pros::E_CONTROLLER_DIGITAL_L2)) {

            macroing = false;
            liftL.move(-127);
            liftR.move(-127);

        } else if (master.get_digital(pros::E_CONTROLLER_DIGITAL_R1) && clamping && liftL.get_position() < 300) {
            macroing = true;
            float curPos = (liftL.get_position() + liftR.get_position())/2;
            targetPos = curPos+100;
            
        } else {

            if (macroing) {
                float curPos = (liftL.get_position() + liftR.get_position())/2;
                if (curPos < targetPos) {
                    liftL.move(127);
                    liftR.move(127);
                } else {
                    macroing = false;
                    lift_stop(); 
                }
            } else {
                lift_stop();
            }
            
        }
        pros::delay(20);
    }
}

void open_claw() {
    claw.set_value(HIGH); 
}

void close_claw() {
    claw.set_value(LOW);
}

// may need more debugging
void control_claw(void* param) {

    while (true) {
        if (master.get_digital_new_press(pros::E_CONTROLLER_DIGITAL_R1)) {

            // turn claw on
            if (!clamping) {
                close_claw();

            } else {
                open_claw();
            }

            clamping = !clamping;
        }

    }

    pros::delay(50);
}

/**
 * Runs initialization code. This occurs as soon as the program is started.
 *
 * All other competition modes are blocked by initialize; it is recommended
 * to keep execution time for this mode under a few seconds.
 */
void initialize() {
    left_motors.set_gearing({pros::MotorGears::blue, pros::MotorGears::green, pros::MotorGears::blue});
    right_motors.set_gearing({pros::MotorGears::blue, pros::MotorGears::green, pros::MotorGears::blue});

    liftL.set_encoder_units(pros::E_MOTOR_ENCODER_DEGREES);
    liftR.set_encoder_units(pros::E_MOTOR_ENCODER_DEGREES);
    liftL.tare_position();
    liftR.tare_position();
    liftL.move_velocity(100);
    liftR.move_velocity(100);

    std::cout << "left motors: %f" << left_motors.get_temperature() << "\nright motors: %f" << right_motors.get_temperature() << std::endl;

    master.clear();
    
    //inertial_sensor.reset();
	pros::lcd::initialize(); // initialize brain screen
    chassis.calibrate(); // calibrate sensors
    // print position to brain screen
    new pros::Task([&]() {
        while (true) {
            // print robot location to the brain screen
            pros::lcd::print(0, "X: %f", chassis.getPose().x); // x
            pros::lcd::print(1, "Y: %f", chassis.getPose().y); // y
            pros::lcd::print(2, "Theta: %f", chassis.getPose().theta); // heading
            pros::lcd::print(3, "lfitL: %f", liftL.get_position()); // y
            pros::lcd::print(4, "liftR: %f", liftR.get_position()); // heading

            // delay to save resources
            pros::delay(50);
        }
    });
}

